* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.lock text eol=lf

# These files are checksum-pinned upstream bytes with mixed line endings.
# Treat them as opaque so Git never rewrites their byte representation.
third_party/dcsa/** -text whitespace=-blank-at-eol

# Raw adapter recipe bytes are checksum-pinned and must be platform invariant.
src/cargomesh/adapters/data/*.json text eol=lf
